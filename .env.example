# --- vkai-insurance-client-api environment ---
# Copy to .env and fill in real values. .env is gitignored; never commit secrets.

# HTTP port the API listens on
VKAI_INSURANCE_CLIENT_API_PORT=4000

# PostgreSQL connection string (matches docker-compose defaults for local dev)
VKAI_INSURANCE_CLIENT_API_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vkai_insurance_client_dev

# Firebase Admin service-account credentials (used to verify customer JWTs)
VKAI_INSURANCE_CLIENT_API_FIREBASE_PROJECT_ID=
VKAI_INSURANCE_CLIENT_API_FIREBASE_CLIENT_EMAIL=
# Paste the private key on a single line with literal \n for newlines, wrapped in quotes.
VKAI_INSURANCE_CLIENT_API_FIREBASE_PRIVATE_KEY=

# Shared secret for provider <-> client sync (inbound auth + outbound signing)
VKAI_INSURANCE_CLIENT_API_SYNC_KEY=

# Base URL of the provider (Azure) API this client syncs with
VKAI_INSURANCE_PROVIDER_API_BASE_URL=http://localhost:4100

# Frontend origin allowed by CORS (Vite dev server)
VKAI_INSURANCE_CLIENT_API_ALLOWED_ORIGIN=http://localhost:5173

# Log level: trace | debug | info | warn | error | fatal
VKAI_INSURANCE_CLIENT_API_LOG_LEVEL=info
VKAI_INSURANCE_CLIENT_API_SYNC_KEY=e2b9c944db5e4f87eb227e32ef18920e33ffd96d13f92ebf09cd75731384299e